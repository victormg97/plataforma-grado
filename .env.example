NEXT_PUBLIC_TENANT_ID=cta-graduados
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DB_URL=postgresql://postgres:YOUR-PASSWORD@db.your-project.supabase.co:5432/postgres
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SEO / Dominios (opcional — sobreescriben lo definido en config/tenants/*.ts)
# ---------------------------------------------------------------------------
# URL canonica publica del landing (www). Se usa como metadataBase, canonical,
# base del sitemap y JSON-LD. En produccion apunta a tu dominio real.
#   NEXT_PUBLIC_SITE_URL=https://www.preguntaestrategica.cl
# Hostname del subdominio de la plataforma (app.). El middleware separa el
# landing (www) de la plataforma (app.) usando este valor.
#   NEXT_PUBLIC_APP_HOST=app.preguntaestrategica.cl

# Resend (envio de correo) - opcional por tenant. Solo-servidor: sin prefijo NEXT_PUBLIC_.
# Si no se configura (ausente o vacia), no se envian correos y la app sigue operando con normalidad.
RESEND_API_KEY=re_placeholder_no_valida
